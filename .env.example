# QQMP 后端接口服务（api/）环境变量示例
#
# 用法：复制为 .env 后按需填写。.env 已被 .gitignore 忽略（含 cookie 凭据，绝不入库）。
#   cp api/.env.example api/.env
#
# ⚠️ 正常情况下【不需要】填这个文件：
#   播放器采用「严格多用户」设计——每台设备在页面里（设置 → 账号）配置自己的登录凭据，
#   随请求头 X-QQ-Music-Cookie / X-QQ-Music-Uin 下发、服务端按用户隔离且不落盘。
#   下面这些变量只是本机调试用的回退通道（API Explorer / curl 直连 3200）。

# ---------------------------------------------------------------------------
# 全局 cookie 回退（本机调试用，默认关闭）
# ---------------------------------------------------------------------------
# 置为 1 才启用全局 cookie：此时服务端用下面两行代替「每用户请求头凭据」。
# 出于安全，仅在请求来源是本机回环（127.0.0.1）时才生效——经 8080 反向代理转发的
# 局域网设备仍按未登录处理，不会串到你的账号。
# QQ_MUSIC_USE_GLOBAL_COOKIE=0

# 你的 QQ 音乐 cookie：登录 https://y.qq.com 后从浏览器开发者工具里复制整条 cookie 串。
# 必须是完整 cookie（含 uin 与认证类字段），否则播放/红心等接口会返回 1000 / 104003。
# QQ_MUSIC_COOKIE=
# 你的 QQ 号
# QQ_MUSIC_UIN=

# ---------------------------------------------------------------------------
# 其它（一般无需修改）
# ---------------------------------------------------------------------------
# 内部接口服务的监听端口（默认 3200）。改动后需同步 server.mjs / electron 侧的
# API_PORT，否则前端反代会打空。
# PORT=3200

# 写代理地址（默认 http://localhost:9339）：红心/收藏等写操作经它走官方加密链路，
# 由 `npm run proxy` 启动。改端口需与 scripts/qq-write-proxy.mjs 保持一致。
# PROXY_URL=http://localhost:9339

# 日志级别：debug | info | warn | error
# LOG_LEVEL=info
